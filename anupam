<script>
(function() {

  var d = document.documentElement;
  d.classList.add("js");

  var pages = [
    "about",
    "education",
    "experience",
    "publications",
    "awards",
    "leadership"
  ];

  var links = [].slice.call(
    document.querySelectorAll(".menu a")
  );

  function go(h) {
    if (pages.indexOf(h) < 0) h = "about";

    pages.forEach(function(p) {
      document.getElementById("p-" + p)
        .classList.toggle("on", p === h);
    });

    links.forEach(function(a) {
      a.classList.toggle(
        "on",
        a.getAttribute("href") === "#" + h
      );
    });

    document.getElementById("card").scrollTop = 0;
    window.scrollTo(0, 0);
  }

  function show() {
    go((location.hash || "#about").slice(1));
  }

  links.forEach(function(a) {
    a.addEventListener("click", function(e) {
      e.preventDefault();

      var h = a.getAttribute("href").slice(1);
      go(h);

      try {
        history.replaceState(null, "", "#" + h);
      } catch(x) {}
    });
  });

  addEventListener("hashchange", show);
  show();

  document.addEventListener("click", function(e) {
    var a = e.target.closest && e.target.closest('a[href="#"]');
    if (a) e.preventDefault();
  });

  var more = document.getElementById("more");
  var ex = document.getElementById("extra");

  more.addEventListener("click", function() {
    var on = ex.classList.toggle("on");

    more.textContent = on ? "Read less ‹" : "Read more ›";
    more.setAttribute("aria-expanded", on);
  });

  var roles = [
    "Avionics Engineer",
    "Antenna & RF Researcher",
    "Radar & ISAC Researcher"
  ];

  var el = document.getElementById("typed");

  if (matchMedia("(prefers-reduced-motion:reduce)").matches) {
    el.textContent = roles[0];
    return;
  }

  var r = 0;
  var i = 0;
  var del = false;

  (function tick() {
    var w = roles[r];

    i += del ? -1 : 1;
    el.textContent = w.slice(0, i);

    var t = del ? 35 : 70;

    if (!del && i === w.length) {
      del = true;
      t = 1600;
    } else if (del && i === 0) {
      del = false;
      r = (r + 1) % roles.length;
      t = 300;
    }

    setTimeout(tick, t);
  })();

  var ph = [0, 90, 180, 270];
  var pi = 0;
  var phi = document.getElementById("phi");
  var tx = document.getElementById("tx");

  function p3(n) {
    return ("00" + n).slice(-3);
  }

  function b4() {
    var s = "";
    for (var k = 0; k < 4; k++) {
      s += Math.round(Math.random());
    }
    return s;
  }

  setInterval(function() {
    pi = (pi + 1) % 4;

    phi.textContent =
      "Φ " + p3(ph[pi]) + " " + p3(ph[(pi + 2) % 4]);

    tx.textContent = "TX " + b4() + " " + b4();
  }, 1500);

})();
</script>

